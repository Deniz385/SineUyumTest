    "RefreshTokenDays": 60
  },
  "Admin": {
    "UserName": "",
    "Email": "",
    "Password": ""
  },
  "App": {
    "MinimumSupportedVersion": "1.0.0",
    "LatestVersion": "1.0.0",
    "MaintenanceMode": false
  },
  "TMDb": {
    "ApiKey": "",
