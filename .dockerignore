# Keeps the build context small and clean: none of this belongs in the image.
**/bin/
**/obj/
**/.vs/
**/.vscode/

# Local database files — must never end up in the image (sensitive data, G2).
**/*.db
**/*.db-shm
**/*.db-wal

# The Dockerfile only publishes the API; these are not needed in the context.
sine-uyum-web/
sine_uyum_mobile/
SineUyum.Api.Tests/
docs/
.git/
.github/
**/*.md
