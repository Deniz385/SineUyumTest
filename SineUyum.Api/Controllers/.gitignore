# Standard .gitignore for Visual Studio and .NET

## User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

## Visual Studio generated folders
.vs/
*.cr/
*.[Cc]ache/
ClientBin/
[Bb]in/
[Dd]ebug/
[Dd]ebug[Ss]ymbols/
[Oo]bj/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]uild[Ss]erver/
[Dd]rop/
[Ll]ogs/

## Regenerable files (ReSharper)
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

## Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.[Pp]ublish.xml
*.[Pp]ublish[Pp]rofiles
*.builds
*.pidb
*.log
*.scc

## Packages
*.nupkg
*.nuget.props
*.nuget.targets
packages/
*.lock.json

## Secrets and local settings
# Hides the secrets.json file of UserSecrets inside the C# project
**/secrets.json

# appsettings file specific to the local development environment
appsettings.Development.json

## Miscellaneous
*.docmd
*.pdb
*_i.c
*_p.c
*_i.h
*.ilk
*.meta
*.obj
*.pch
*.pre
*.pfx
*.publishsettings
.ntvs_analysis.dat
.deploy_version
~$*

# Rider IDE files
.idea/

# Our project-specific additions
# -------------------------------------------------------------------
# Ignore SQLite database files
*.db
*.db-journal
