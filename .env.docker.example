# docker compose için örnek ortam değişkenleri.
# Kopyala:  cp .env.docker.example .env   ve değerleri doldur.
# .env repoya GİRMEZ (.gitignore'da).

# JWT imzalama anahtarı — HS512 için en az 64 karakter olmalı.
# Üretmek için:  openssl rand -base64 64 | tr -d '\n'
JWT_KEY=

# TMDb API anahtarı (film arama/detay/popüler için).
TMDB_API_KEY=

# İlk admin hesabı (opsiyonel; ikisi de boşsa admin oluşturulmaz).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@sineuyum.local

# Push bildirimi (FCM) — opsiyonel; boşsa push kapalıdır.
# Firebase konsolu → Proje ayarları → Hizmet hesapları → "Yeni özel anahtar
# oluştur" ile inen JSON, TEK SATIRA indirilip tek tırnakla yazılır:
#   echo "FCM_SERVICE_ACCOUNT_JSON='$(jq -c . anahtar.json)'" >> .env
# Bu anahtar GİZLİDİR; repoya girmemeli.
FCM_SERVICE_ACCOUNT_JSON=

# Web istemcisinin adresi (CORS).
WEB_ORIGIN=http://localhost:5173

# Ters vekil (nginx, yük dengeleyici) kullanıyorsan onun IP'si ya da ağı,
# virgülle: ör. 172.18.0.0/16. Boş bırakılırsa X-Forwarded-For yok sayılır.
# Yanlış/eksik ayarda tüm kullanıcılar vekilin IP'sini paylaşır ve IP başına
# istek sınırları herkesi birlikte keser.
TRUSTED_PROXIES=

# Ortam (Production = HTTPS yönlendirme + HSTS açık).
ASPNETCORE_ENVIRONMENT=Production

# --- PostgreSQL (docker-compose'daki db servisi) ---
POSTGRES_DB=sineuyum
POSTGRES_USER=sineuyum
# Zorunlu — güçlü bir parola belirle.
POSTGRES_PASSWORD=
