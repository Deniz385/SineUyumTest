# Example environment variables for docker compose.
# Copy:  cp .env.docker.example .env   and fill in the values.
# .env is NOT committed to the repository (it is in .gitignore).

# JWT signing key — must be at least 64 characters for HS512.
# To generate one:  openssl rand -base64 64 | tr -d '\n'
JWT_KEY=

# TMDb API key (for movie search/details/popular).
TMDB_API_KEY=

# Initial admin account (optional; if both are empty, no admin is created).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@sineuyum.local

# Push notifications (FCM) — optional; push is disabled when empty.
# The JSON downloaded via Firebase console → Project settings → Service
# accounts → "Generate new private key", collapsed to a SINGLE LINE and
# wrapped in single quotes:
#   echo "FCM_SERVICE_ACCOUNT_JSON='$(jq -c . key.json)'" >> .env
# This key is SECRET; it must not be committed to the repository.
FCM_SERVICE_ACCOUNT_JSON=

# Address of the web client (CORS).
WEB_ORIGIN=http://localhost:5173

# If you run behind a reverse proxy (nginx, load balancer), its IP or network,
# comma-separated: e.g. 172.18.0.0/16. If left empty, X-Forwarded-For is ignored.
# If this is wrong or missing, all users share the proxy's IP and the per-IP
# request limits throttle everyone together.
TRUSTED_PROXIES=

# Environment (Production = HTTPS redirection + HSTS enabled).
ASPNETCORE_ENVIRONMENT=Production

# --- PostgreSQL (the db service in docker-compose) ---
POSTGRES_DB=sineuyum
POSTGRES_USER=sineuyum
# Required — choose a strong password.
POSTGRES_PASSWORD=
